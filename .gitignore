# Dependências
node_modules/

# Banco de dados local e arquivos de trabalho (T-05: banco com dados reais nunca é commitado)
data/*
!data/.gitkeep
*.sqlite
*.sqlite3
*.db
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Segredos / configuração local
.env
.env.*
!.env.example

# Fontes legadas privadas (dados pessoais/financeiros reais)
#
# A planilha e a ficha de cadastro da ACASA contêm dados reais de associados e
# NÃO podem ficar versionadas em repositório público. Elas continuam existindo
# localmente — a importação (`npm run import:legacy`) lê o arquivo do disco por
# caminho, nunca do Git. Metadados e SHA-256 em docs/legacy/source-manifest.md.
controle-de-pagamento.xlsx
ficha-de-cadastro.pdf
private/
*.xlsx
*.xlsm
*.csv
*.pdf
# Exceção deliberada: fontes de baseline normativo não são dado pessoal.
!KB-BASELINE-ACASA-*.pdf

# Build do Next.js
.next/
out/
next-env.d.ts

# Cache incremental do typecheck (`npm run typecheck`, ADR-007) — artefato local
*.tsbuildinfo

# Logs e temporários
*.log
npm-debug.log*
tmp/
.tmp/

# Sistema operacional / editor
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
